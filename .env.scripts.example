# Solo para scripts/manage-users.mjs en la computadora del administrador.
# Copia a .env.scripts. Este archivo y la llave JSON NO se suben a GitHub ni a Netlify.
FIREBASE_PROJECT_ID=tu-proyecto
# Ruta a la llave de cuenta de servicio (Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada).
# Guárdala FUERA de la carpeta del proyecto si es posible.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/segura/service-account.json
# Debe coincidir con VITE_EMPLOYEE_EMAIL_DOMAIN del frontend.
EMPLOYEE_EMAIL_DOMAIN=flotilla.example.com
